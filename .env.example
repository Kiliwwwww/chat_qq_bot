DRIVER=~fastapi
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
SUPERUSERS=[""]
NICKNAME=[]
COMMAND_START=["/", ""]

# AI 配置
ai_api_key=xxx
ai_base_url=xxx
ai_model=mimo-v2.5
ai_max_tokens=1024
ai_temperature=1.0
ai_top_p=0.95

# 上下文历史记录条数（发给 AI 的最大消息条数，不含系统提示词）
ai_context_limit=50
# 历史消息里的图片是否清理
# false（默认）：最近 50 条历史里的图片都会保留并发给 AI
# true：只保留最新一条消息的图片，更早的图片退化成文本
history_image_clean_enabled=false


# 管理员QQ号（只有此人可修改群/用户白名单设置）
admin_qq=xxx

# 可视化管理面板（访问 /admin）；密码留空时面板无法登录
admin_panel_enabled=true
admin_panel_password=
# 登录有效期（小时）
admin_panel_session_hours=12

# 群消息回复概率 (0.0~1.0)
group_reply_chance=0.01

# 对话延续：机器人刚说完话，被它搭话的那个人紧接着直接回一句（不@、不引用），
# 只要中间没被群里其他人插话，就按"在跟机器人说话"处理，不用每次都重新@
group_follow_up_enabled=true
# 延续判定的时间窗口（秒）
group_follow_up_window=60
# 延续消息的回复概率（1.0 表示一定接话）
group_follow_up_chance=1.0

# 调试日志开关（开启后会打印发送给AI的完整JSON）
ai_debug_log=false

# 本地存储使用当前目录
LOCALSTORE_USE_CWD=true

# 联网搜索配置（可选，博查 Bocha Web Search，用于实时信息搜索）
web_search_enabled=false
web_search_api_key=
web_search_count=5

# RAGFlow 配置（可选，用于知识库检索增强）
ragflow_enabled=false
ragflow_base_url=http://127.0.0.1
ragflow_api_key=
ragflow_kb_ids=[]
ragflow_top_k=5

# TTS 语音朗读配置
tts_enabled=true
tts_base_url=http://qwen-tts:8000
tts_speaker=Vivian
tts_language=Chinese
tts_instruct=用温柔可爱的语气，说标准普通话
tts_max_chars=200

# 连发消息（AI 判断是否需要多回几句，在主回复之外补发消息）
multi_message_enabled=true
# 单轮最多发送的消息总条数（含主回复）
multi_message_max=3
# 关键词强制连发（群友说"多说几句"之类时固定连发）
multi_message_force_enabled=true
# 强制连发时随机条数范围（含主回复）
multi_message_force_min=2
multi_message_force_max=3

# 补给箱开箱（网页截图 GIF）
lottery_daily_limit=3
lottery_gif_duration_ms=3200
lottery_gif_fps=10
lottery_gif_max_width=500
lottery_timezone=Asia/Shanghai

# 表情包每日自动同步（奶-hub，已存在的文件自动跳过）
meme_sync_enabled=true
# 每天几点几分执行（24 小时制，按下面的时区计）
meme_sync_hour=0
meme_sync_minute=0
meme_sync_timezone=Asia/Shanghai
# 并发下载数与单张超时秒数
meme_sync_workers=8
meme_sync_timeout=30
# 下载入口：auto 自动探测（推荐）/ direct 直连 / p0 p1 p2 指定镜像
meme_sync_route=auto
# 可选筛选，留空表示全部；角色可选 naiwa,naidan,nai-emblem,others，分类可选 animated,static
meme_sync_chars=
meme_sync_subs=
# 图片保存目录
meme_sync_out_dir=data/naihub-img

# 奶龙表情包（开启功能的群里，AI 回复后会单独再发一条随机表情包）
# 开启功能的群号，可写多个，例如 [123456789,987654321]；也可在群里用 /开启奶龙 动态开关
meme_group_ids=[]
# 回复后单独跟一条表情包的概率（1.0 表示每条回复都跟一张，0 表示不跟）
meme_attach_chance=1.0
# 同义概率，与上面取较大值生效（避免叠加时连发两张）
meme_standalone_chance=0.2
# 主动冒泡之后是否也单独跟一条表情包
meme_bubble_attach=true
# 单张表情包体积上限（字节），超过的图片不进候选池，默认 8MB
meme_max_bytes=8388608

# 存表情（管理员私聊发 /存表情 /分组/子分组 后，随后发来的图片都会存到该目录）
# 图片保存根目录：留空 = 直接存进奶龙表情库（data/naihub-img），
# 存下来的图立刻能被 /今日奶龙 和开启奶龙后的 AI 跟图抽到；
# 不带目录的 /存表情 会落到这个根目录下的「手存」文件夹
# 想另存别处就写一个目录（相对项目根目录），例如 data/saved_images
save_meme_root=
# 单张图片体积上限（字节），超过的跳过，默认 20MB
save_meme_max_bytes=20971520
# 注意：奶龙库自己还有 meme_max_bytes（默认 8MB）上限，
# 存进去了但超过这个大小的图不会被抽到，插件会在结束收图时提醒

# 今日新闻（微博热搜 + 知乎热榜，推送到 groupsettings 里的所有群）
# 开启后每天早上定时推送一次，管理员也可以私聊发送「今日新闻」手动触发
daily_news_enabled=true
# 每天几点几分推送（按 daily_news_timezone 计时），默认早上 9 点
daily_news_hour=9
daily_news_minute=0
daily_news_timezone=Asia/Shanghai
# 两个榜单分别取前几条
daily_news_weibo_count=5
daily_news_zhihu_count=5

# Docker 构建镜像源（可选，用于加速依赖和 Playwright 浏览器下载）
PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
PLAYWRIGHT_DOWNLOAD_HOST=https://npmmirror.com/mirrors/playwright/
