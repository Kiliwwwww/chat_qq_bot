DRIVER=~fastapi
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
SUPERUSERS=[""]
NICKNAME=[]
COMMAND_START=["/", ""]

# AI 配置
ai_api_key=xxx
ai_base_url=xxx
ai_model=mimo-v2.5
ai_max_tokens=1024
ai_temperature=1.0
ai_top_p=0.95


# 管理员QQ号（只有此人可修改群/用户白名单设置）
admin_qq=xxx

# 群消息回复概率 (0.0~1.0)
group_reply_chance=0.01

# 调试日志开关（开启后会打印发送给AI的完整JSON）
ai_debug_log=false

# 本地存储使用当前目录
LOCALSTORE_USE_CWD=true

# 联网搜索配置（可选，博查 Bocha Web Search，用于实时信息搜索）
web_search_enabled=false
web_search_api_key=
web_search_count=5

# RAGFlow 配置（可选，用于知识库检索增强）
ragflow_enabled=false
ragflow_base_url=http://127.0.0.1
ragflow_api_key=
ragflow_kb_ids=[]
ragflow_top_k=5

# TTS 语音朗读配置
tts_enabled=true
tts_base_url=http://qwen-tts:8000
tts_speaker=Vivian
tts_language=Chinese
tts_instruct=用温柔可爱的语气，说标准普通话
tts_max_chars=200

# 连发消息（AI 判断是否需要多回几句，在主回复之外补发消息）
multi_message_enabled=true
# 单轮最多发送的消息总条数（含主回复）
multi_message_max=3
# 关键词强制连发（群友说"多说几句"之类时固定连发）
multi_message_force_enabled=true
# 强制连发时随机条数范围（含主回复）
multi_message_force_min=2
multi_message_force_max=3

# 补给箱开箱（网页截图 GIF）
lottery_daily_limit=3
lottery_gif_duration_ms=3200
lottery_gif_fps=10
lottery_gif_max_width=500
lottery_timezone=Asia/Shanghai

# 表情包每日自动同步（奶-hub，已存在的文件自动跳过）
meme_sync_enabled=true
# 每天几点几分执行（24 小时制，按下面的时区计）
meme_sync_hour=0
meme_sync_minute=0
meme_sync_timezone=Asia/Shanghai
# 并发下载数与单张超时秒数
meme_sync_workers=8
meme_sync_timeout=30
# 下载入口：auto 自动探测（推荐）/ direct 直连 / p0 p1 p2 指定镜像
meme_sync_route=auto
# 可选筛选，留空表示全部；角色可选 naiwa,naidan,nai-emblem,others，分类可选 animated,static
meme_sync_chars=
meme_sync_subs=
# 图片保存目录
meme_sync_out_dir=data/naihub-img

# 奶龙表情包（开启功能的群里，AI 回复会带一张随机表情包）
# 开启功能的群号，可写多个，例如 [123456789,987654321]；也可在群里用 /开启奶龙 动态开关
meme_group_ids=[]
# AI 回复附带表情包的概率（1.0 表示每条都带，0 表示不带）
meme_attach_chance=1.0
# 回复群友之后，额外单独发一张表情包的概率（不回复任何人，直接发群里）
meme_standalone_chance=0.2
# 主动冒泡消息是否也附带表情包
meme_bubble_attach=true

# Docker 构建镜像源（可选，用于加速依赖和 Playwright 浏览器下载）
PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
PLAYWRIGHT_DOWNLOAD_HOST=https://npmmirror.com/mirrors/playwright/
